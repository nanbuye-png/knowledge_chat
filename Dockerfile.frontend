# Frontend Dockerfile
FROM node:20-alpine

WORKDIR /app

# 复制依赖文件
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# 复制项目代码
COPY frontend/ .

# 构建前端
RUN npm run build

# 使用 nginx 作为静态文件服务器
FROM nginx:alpine
COPY --from=0 /app/dist /usr/share/nginx/html

# nginx 配置将在 docker-compose 中挂载
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]