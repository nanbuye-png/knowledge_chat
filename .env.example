# LLM Provider 选择（deepseek 或 agens）
LLM_PROVIDER=deepseek

# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com

# Agens API 配置
AGENS_API_KEY=sk-your-api-key-here
AGENS_API_BASE=https://apihub.agnes-ai.com/v1

# LLM HTTP 客户端（代理开关 / 超时）
# 当系统代理（如 Clash 的 127.0.0.1:7897）干扰 LLM API 连接时设为 true 绕过代理直连
# LLM_DISABLE_PROXY=false
# LLM_TIMEOUT=120.0
# LLM_CONNECT_TIMEOUT=10.0

#选择LLM模型（随 LLM_PROVIDER 变化）
#  deepseek 可选: deepseek-chat / deepseek-reasoner
#  agens   可选: agnes-2.5-flash / agnes-2.5-pro / agnes-3.0-flash / agnes-2.0-flash
LLM_MODEL=deepseek-chat

# 嵌入模型（首次启动会自动下载）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 日志级别
LOG_LEVEL=INFO

# ===================== 检索链路（Phase 1 引入）=====================
# 检索模式：hybrid（向量 + BM25 融合，默认）| vector（纯向量，评测基线）
# RETRIEVAL_MODE=hybrid
# 召回分下限：低于该分数的 chunk 不进入上下文。注意分数含义随模式变化：
#   vector = 余弦相似度；hybrid = 两通道归一化融合分，需按模式分别标定
# （标定方法与实测数据见 docs/RAG_EVALUATION.md）
# RETRIEVAL_MIN_SCORE=0.3
# 融合权重（两者之和建议为 1）
# HYBRID_VECTOR_WEIGHT=0.5
# HYBRID_BM25_WEIGHT=0.5
# 混合检索每条通道的召回数量（融合前的候选池）
# HYBRID_RECALL_K=20
# BM25 稀疏索引文件路径（默认在向量库目录下）
# SPARSE_INDEX_PATH=./chroma_db/sparse_index.db
# BM25 词频饱和 / 长度归一化参数
# SPARSE_BM25_K1=1.5
# SPARSE_BM25_B=0.75
# 稀疏通道失败时是否降级为纯向量检索（默认 true）
# SPARSE_INDEX_FALLBACK=true

# ---- Reranker ----
# RERANKER_ENABLED=true
# RERANKER_TYPE=lexical（零依赖默认）| cross_encoder（需下载 BAAI/bge-reranker-base）
# RERANKER_MODEL=BAAI/bge-reranker-base
# RERANKER_CANDIDATES=20
# RERANKER_TOP_K=5
# RERANKER_TIMEOUT=10.0
# RERANKER_BATCH_SIZE=16

# ---- 上下文过滤（低于阈值的 chunk 不进入 LLM）----
# 0 表示关闭；建议取值由 RAG 评测标定（见 docs/RAG_EVALUATION.md）
# CONTEXT_SCORE_THRESHOLD=0.0
# 分数来源：auto（优先 rerank_score，缺失回退 score）| rerank | retrieval
# CONTEXT_SCORE_SOURCE=auto

# ---- 拒答 Abstention（无足够依据时不调用 LLM）----
# ABSTENTION_ENABLED=true
# ABSTENTION_MESSAGE=当前知识库中没有找到足够的信息来回答该问题。
# 有效上下文 chunk 数下限
# ABSTENTION_MIN_CONTEXT_CHUNKS=1
# 最高召回分下限（<=0 表示不按分数拒答）；建议取值由 RAG 评测标定
# ABSTENTION_SCORE_THRESHOLD=0.0
# 最高重排分下限（<=0 表示不启用）
# ABSTENTION_RERANK_THRESHOLD=0.0

# ---- Query Rewrite（用 LLM 补全指代/省略主语；失败自动回退原 Query）----
# QUERY_REWRITE_ENABLED=true
# QUERY_REWRITE_TIMEOUT=10.0
# QUERY_REWRITE_MAX_HISTORY=4
# QUERY_REWRITE_MIN_CHARS=4
# QUERY_REWRITE_MAX_CHARS=200

# ---- 异步入库（P0-4）----
# true：上传后立即返回 PENDING，由后台 Worker 处理（默认）
# false：在请求内同步处理
# DOCUMENT_PROCESSING_ASYNC=true
# 后台 Worker 并发上限
# WORKER_MAX_CONCURRENCY=4

# ---- 上传幂等（Phase 3 §5.3）----
# true：同一知识库内上传内容完全相同的文件时跳过重复处理
#   （已完成/处理中的命中 → 直接返回既有记录；命中 FAILED 记录 → 复用该记录重跑）
# false：关闭去重，每次上传都新建记录
# DOCUMENT_DEDUP_ENABLED=true

# ===================== 可观测性（Phase 3 §5.6）=====================
# Prometheus 指标中间件开关（/metrics 路由始终注册）。
# 请求级指标：knowledge_request_total / knowledge_request_latency_seconds，
# 分段耗时：knowledge_rag_stage_latency_seconds{stage=rewrite|embed|retrieve|rerank|context_filter|llm}，
# 韧性指标：knowledge_retry_total / knowledge_retry_exhausted_total，
# 业务指标：knowledge_abstention_total / knowledge_document_status_total /
#          knowledge_document_dedup_total。
# METRICS_ENABLED=true

# ===================== 统一重试（Phase 3 §5.2）=====================
# 审计 §5.2：LLM / 嵌入调用此前零重试，一次 429 或连接抖动就让整篇文档
# FAILED、或让一次问答直接报错。以下配置是**全项目唯一**的重试策略入口
# （评测裁判与线上链路共用同一套可重试判定）。
# 总开关；false 时所有重试退化为单次调用（排障/压测时用）
# RETRY_ENABLED=true
# 总尝试次数（含首次调用）：3 表示最多重试 2 次
# RETRY_MAX_ATTEMPTS=3
# 首次重试前的等待秒数（指数退避起点）
# RETRY_BASE_DELAY=1.0
# 单次等待上限（秒）
# RETRY_MAX_DELAY=30.0
# 退避倍数（2.0 → 1s, 2s, 4s, ...）
# RETRY_BACKOFF_FACTOR=2.0
# 抖动比例（±20%），避免多任务同时重试再次撞上限流
# RETRY_JITTER=0.2
# 按调用类型覆盖尝试次数（0 = 沿用 RETRY_MAX_ATTEMPTS）
# LLM_RETRY_MAX_ATTEMPTS=3
# EMBEDDING_RETRY_MAX_ATTEMPTS=3
# 文档级（整篇入库）重试：次数少、退避长，避免与调用级重试叠乘
# TASK_RETRY_MAX_ATTEMPTS=2
# TASK_RETRY_BACKOFF_S=5.0
# TASK_RETRY_MAX_BACKOFF_S=60.0

# ===================== RAG 评测（Phase 2）=====================
# 裁判模型单次最大 token。推理型模型（agnes-2.5-flash）会先输出
# reasoning_content，留太小会导致裁判正文为空。
# EVAL_JUDGE_MAX_TOKENS=800
# 裁判温度（0 = 尽量确定性）
# EVAL_JUDGE_TEMPERATURE=0.0