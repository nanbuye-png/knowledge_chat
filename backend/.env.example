# LLM Provider 选择（deepseek 或 agens）
LLM_PROVIDER=deepseek

# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com

# Agens API 配置
AGENS_API_KEY=
AGENS_API_BASE=

#选择LLM模型，deepseek-chat 或 agnes-2.0-flash
LLM_MODEL=deepseek-chat

# 数据库类型: "sqlite" 或 "postgresql"
DATABASE_TYPE=sqlite

# 数据库连接 URL（SQLite 模式）
DATABASE_URL=sqlite+aiosqlite:///./knowledge.db

# PostgreSQL 配置（当 DATABASE_TYPE=postgresql 时生效）
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=knowledge_chat

# 连接池配置（仅 PostgreSQL 使用）
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20
# DATABASE_POOL_RECYCLE=3600

# 向量存储配置
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_db

# 嵌入模型配置
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 应用配置
APP_NAME=智能知识库问答系统
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# 文件上传配置
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# 文档分块配置
CHUNK_SIZE=500
CHUNK_OVERLAP=100