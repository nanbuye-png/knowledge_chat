# ============================================================
# knowledge_chat v1.0.1 生产环境配置模板
#
# 使用方法：
#   1. cp .env.production .env.production.local
#   2. 填写下方所有 change-me 占位的真实值
#   3. 启动：docker compose --env-file .env.production.local -f docker-compose.prod.yml up -d --build
#   4. 初始化 ROOT 用户（见 README「Docker 部署」章节）
#
# 注意：
#   - 本文件通过 env_file 注入容器，环境变量值将按字面量传递，请直接填写真实值
#   - 根目录 .env 文件中的同名变量会由 docker-compose.prod.yml 的 environment 覆盖
# ============================================================
ENVIRONMENT=production
LOG_LEVEL=INFO

# Database
DATABASE_TYPE=postgresql
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=knowledge_chat

# Redis（Docker Compose 内使用服务名 redis；外部部署时改为对应地址）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# LLM Provider（deepseek 或 agens）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Agens（切换 LLM_PROVIDER=agens 时使用）
AGENS_API_KEY=
AGENS_API_BASE=https://apihub.agnes-ai.com/v1

# Embedding（首次启动会自动下载模型）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Security（必填，使用随机长字符串，如 openssl rand -hex 32）
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS（替换为实际访问域名）
CORS_ORIGINS=["http://localhost:80","http://localhost","https://your-domain.com"]

# Infrastructure
CACHE_BACKEND=redis
# local：异步任务在 API 进程内执行；未来支持 celery 后可选独立 Worker
WORKER_BACKEND=local